# =============================================================================
#  PRODUCT ACTIVATION SUITE — ENVIRONMENT VARIABLES TEMPLATE
#  Copy this file, rename it to .dev.vars, and fill in your values.
#  For Cloudflare Workers: add these as Variables & Secrets in the dashboard.
# =============================================================================


# -----------------------------------------------------------------------------
#  REQUIRED — Supabase Database
#  Get these from: https://supabase.com → Your Project → Settings → API
# -----------------------------------------------------------------------------

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# -----------------------------------------------------------------------------
#  REQUIRED — Admin Dashboard Login
#  These are your credentials to access /admin
# -----------------------------------------------------------------------------

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-admin-password


# -----------------------------------------------------------------------------
#  OPTIONAL — Customer Portal Branding
#  Customize how the portal looks to your customers.
#  These can also be changed live from Admin Dashboard → Page Customization.
# -----------------------------------------------------------------------------

PORTAL_NAME=Activation Portal
PORTAL_SUB=Product Registration
SUPPORT_EMAIL=support@yourdomain.com
SUPPORT_PHONE=

# Color theme for the customer portal UI
# Options: indigo | emerald | violet | orange | sky | slate
THEME_HUE=indigo


# -----------------------------------------------------------------------------
#  OPTIONAL — CORS (Cross-Origin Resource Sharing)
#  Use * to allow all origins, or specify your domain(s) comma-separated.
#  Example: https://mystore.com,https://app.mystore.com
# -----------------------------------------------------------------------------

CORS_ALLOWED_ORIGINS=*


# -----------------------------------------------------------------------------
#  OPTIONAL — Email Notifications via Resend
#  Get your API key from: https://resend.com
#  Used to send OTP verification codes and activation receipts by email.
# -----------------------------------------------------------------------------

RESEND_API_KEY=


# -----------------------------------------------------------------------------
#  OPTIONAL — SMS Notifications via Twilio
#  Get these from: https://twilio.com → Console → Account Info
#  Used to send OTP verification codes by SMS.
# -----------------------------------------------------------------------------

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# -----------------------------------------------------------------------------
#  OPTIONAL — Shopify Webhook Integration
#  Get this from: Shopify Admin → Settings → Notifications → Webhooks
#  Used to auto-provision license keys when a Shopify order is completed.
# -----------------------------------------------------------------------------

SHOPIFY_WEBHOOK_SECRET=


# =============================================================================
#  CLOUDFLARE WORKERS SETUP NOTE
#  Cloudflare Workers does not read .env files directly.
#  Copy each value above into:
#    Workers & Pages → Your Worker → Settings → Variables and Secrets
#
#  Mark sensitive values (keys, passwords, tokens) as "Secret" — not "Text".
# =============================================================================
